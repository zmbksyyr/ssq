{
  "analysis": {
    "prepare_history": {
      "signature": "filepath=CSV_PATH, dependencies=None",
      "inject": {
        "filepath": "CSV_PATH"
      }
    },
    "evaluate_history": {
      "signature": "history, options, params_path=PARAMS_JSON_PATH, dependencies=None",
      "inject": {
        "params_path": "PARAMS_JSON_PATH"
      }
    },
    "save_analysis_report": {
      "signature": "data, report_dir=REPORT_DIR, dependencies=None",
      "inject": {
        "report_dir": "REPORT_DIR"
      }
    },
    "score_red_combination": {
      "signature": "combo, red_scores, last_draw=None, previous_draw=None, rank_center_scores=None, context=None, rule_definitions=None",
      "inject": {
        "rule_definitions": "RED_RULES"
      }
    },
    "score_combination": {
      "signature": "combo, scoring_context, rule_definitions: Sequence[RuleDefinition] | None=None",
      "inject": {
        "rule_definitions": "RED_RULES"
      }
    },
    "validate_rule_registry": {
      "signature": "rule_definitions, signal_weight=COMBINATION_SIGNAL_WEIGHT",
      "inject": {}
    },
    "keep_delegator": {
      "generate_candidates": "ssq_candidate_generation",
      "passes_red_filters": "ssq_rule_execution",
      "explain_filter_failures": "ssq_rule_diagnostics",
      "filter_pipeline_stats": "ssq_rule_diagnostics"
    }
  },
  "bonus_check": {
    "load_latest_draw": {
      "signature": "filepath, normalize=None, validate_dates=None",
      "inject": {
        "normalize": "normalize_draw_frame",
        "validate_dates": "validate_draw_dates_not_future"
      }
    }
  }
}
